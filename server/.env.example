NODE_ENV=development
PORT=3000

# Direct Neon connection string — used by drizzle-kit for migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Pooled Neon connection string (host contains "-pooler") — used by the app runtime.
DATABASE_URL_POOLED=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173

# Required for `npm run db:seed` (not needed at runtime).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
